<Project>
  <ItemGroup>
    <!-- Presentation -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 10.0.x to match .NET 10 LTS. Logging.Abstractions brings DependencyInjection.Abstractions (IServiceCollection) to libraries;
         Logging brings the DI container to the UI composition root and tests. Providers only in the UI root. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
    <!-- WinUI -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.8.0" />
    <!-- WinUI: CommunityToolkit (converters, state triggers, helpers, SettingsCard) -->
    <PackageVersion Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Triggers" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!-- Labs preview, Labs feed (NuGet.config): tray chips. -->
    <PackageVersion Include="CommunityToolkit.Labs.WinUI.TokenView" Version="0.1.250828-build.2223" />
    <!-- Tests -->
    <PackageVersion Include="MSTest" Version="4.2.3" />
  </ItemGroup>
</Project>
