<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Unlocker.WinUI.Pages.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Unlocker.Presentation.Common"
    xmlns:controls="using:Unlocker.WinUI.Controls"
    xmlns:pages="using:Unlocker.WinUI.Pages"
    xmlns:startup="using:Unlocker.Presentation.Startup"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:unlock="using:Unlocker.Presentation.Unlock"
    x:DefaultBindMode="OneWay"
    Loaded="Page_Loaded"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <DataTemplate x:Key="ProfileTile" x:DataType="unlock:CameraProfileItemViewModel">
            <Grid Style="{StaticResource TileGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="ProfileCheckBox"
                    AutomationProperties.HelpText="{x:Bind pages:UnlockPage.InstalledHelp(IsInstalled)}"
                    Content="{x:Bind Name}"
                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                <!--  FontIcon has no automation peer: screen readers get this from the CheckBox HelpText.  -->
                <FontIcon
                    Grid.Column="1"
                    FontSize="16"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xEC61;"
                    ToolTipService.ToolTip="Already installed for your camera. Installing again replaces it."
                    Visibility="{x:Bind IsInstalled}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StatusActionTemplate" x:DataType="common:StatusAction">
            <Button
                Margin="0,0,0,12"
                AutomationProperties.AutomationId="StatusActionButton"
                Command="{x:Bind Command, Mode=OneTime}"
                Content="{x:Bind Label, Mode=OneTime}" />
        </DataTemplate>

        <UniformGridLayout
            x:Key="TileLayout"
            ItemsStretch="Fill"
            MinColumnSpacing="{StaticResource ItemSpacing}"
            MinItemHeight="{StaticResource TileHeight}"
            MinItemWidth="210"
            MinRowSpacing="{StaticResource ItemSpacing}" />
    </Page.Resources>

    <SplitView
        x:Name="CameraPane"
        DisplayMode="Overlay"
        OpenPaneLength="480"
        PaneBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        PaneOpened="CameraPane_PaneOpened"
        PanePlacement="Right">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="StatusSuccess">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger To="Success" Value="{x:Bind ViewModel.Status.Severity, FallbackValue={x:Null}}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatusBar.Severity" Value="Success" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusError">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger To="Error" Value="{x:Bind ViewModel.Status.Severity, FallbackValue={x:Null}}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatusBar.Severity" Value="Error" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="Busy">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsBusy}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChipsPanel.Visibility" Value="Collapsed" />
                        <Setter Target="ClearButton.Visibility" Value="Collapsed" />
                        <Setter Target="InstallIcon.Visibility" Value="Collapsed" />
                        <Setter Target="InstallRing.Visibility" Value="Visible" />
                        <Setter Target="InstallRing.IsActive" Value="True" />
                        <Setter Target="InstallText.Text" Value="Installing…" />
                        <Setter Target="InstallButton.(AutomationProperties.Name)" Value="Installing…" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger MaxWidth="900" TargetElement="{x:Bind Root, Mode=OneTime}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BrandColumn.Width" Value="200" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <SplitView.Pane>
            <Grid
                Padding="24,20,24,24"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                RowSpacing="{StaticResource ItemSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Your camera" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="CloseCameraPaneButton"
                        AutomationProperties.Name="Close"
                        Click="CloseCameraPane_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Camera profiles you install show up when you edit photos from this camera."
                    TextWrapping="Wrap" />
                <controls:CameraPicker
                    x:Name="PanePicker"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Picked="PanePicker_Picked" />
            </Grid>
        </SplitView.Pane>

        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource PageSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="{StaticResource PageSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Unlock camera profiles" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Add camera profiles from other cameras to Lightroom and Photoshop." />
                    </StackPanel>
                    <Button
                        x:Name="TargetButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="TargetButton"
                        Padding="12,8"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind pages:UnlockPage.TargetButtonName(ViewModel.TargetCamera)}"
                        Click="TargetButton_Click"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource Not}}"
                        ToolTipService.ToolTip="Change your camera"
                        Visibility="{x:Bind ViewModel.IsFirstRun, Converter={StaticResource CollapsedWhenTrue}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="18" Glyph="&#xE722;" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Your camera" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.TargetCamera}" />
                            </StackPanel>
                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <InfoBar
                        x:Name="WarningBar"
                        Title="Some cameras are missing."
                        IsOpen="False"
                        Message="Some Camera Raw profiles weren't found. Reinstall Camera Raw with default settings to get them."
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <HyperlinkButton
                                AutomationProperties.AutomationId="GetCameraRawButton"
                                Content="Get Camera Raw"
                                NavigateUri="{x:Bind startup:StartupViewModel.CameraRawDownload, Mode=OneTime}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Name="StatusBar"
                        Title="{x:Bind ViewModel.Status.Title, FallbackValue=''}"
                        Closed="StatusBar_Closed"
                        IsOpen="{x:Bind ViewModel.Status, Converter={StaticResource TrueWhenNotNull}}"
                        Message="{x:Bind ViewModel.Status.Message, FallbackValue=''}">
                        <ItemsRepeater ItemTemplate="{StaticResource StatusActionTemplate}" ItemsSource="{x:Bind ViewModel.Status.Actions, FallbackValue={x:Null}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </InfoBar>
                </StackPanel>

                <!--  First run: pick your camera inline.  -->
                <Grid
                    Grid.Row="2"
                    MaxWidth="560"
                    MaxHeight="580"
                    Padding="28"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    RowSpacing="8"
                    Style="{StaticResource CardGridStyle}"
                    Visibility="{x:Bind ViewModel.IsFirstRun}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Which camera do you shoot with?" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="Camera profiles you add will show up when you edit photos from this camera. You can change it later."
                        TextWrapping="Wrap" />
                    <controls:CameraPicker
                        x:Name="InlinePicker"
                        Grid.Row="2"
                        Picked="InlinePicker_Picked" />
                </Grid>

                <Grid
                    Grid.Row="2"
                    Style="{StaticResource CardGridStyle}"
                    Visibility="{x:Bind ViewModel.IsFirstRun, Converter={StaticResource CollapsedWhenTrue}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BrandColumn" Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Padding="8,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox
                            x:Name="ProfileSearch"
                            Margin="4,0"
                            AutomationProperties.AutomationId="ProfileSearch"
                            AutomationProperties.Name="Search camera profiles"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource Not}}"
                            PlaceholderText="Search camera profiles"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView
                            x:Name="BrandList"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="BrandList"
                            AutomationProperties.Name="Brands"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource Not}}"
                            IsItemClickEnabled="True"
                            ItemClick="BrandList_ItemClick"
                            ItemsSource="{x:Bind ViewModel.VisibleBrands}"
                            SelectedItem="{x:Bind ViewModel.SelectedBrand}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="unlock:BrandItemViewModel">
                                    <Grid Padding="0,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="Your brand"
                                                    Visibility="{x:Bind IsYourBrand}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Family}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind pages:UnlockPage.CountName(SelectedCount, VisibleCount)}"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind pages:UnlockPage.CountText(SelectedCount, VisibleCount)}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Padding="20,16,20,0"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  "Copied from" gets its own full-width row so it never clips when narrow.  -->
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.ProfilesTitle}"
                                TextWrapping="Wrap" />
                            <Grid
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                ColumnSpacing="{StaticResource ItemSpacing}"
                                Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource CollapsedWhenTrue}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="Copied from" />
                                <!--  ItemsSource before SelectedItem: the selection must apply to the new list.  -->
                                <ComboBox
                                    x:Name="ModelBox"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="ModelBox"
                                    AutomationProperties.Name="Copy camera profiles from model"
                                    IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource Not}}"
                                    ItemsSource="{x:Bind ViewModel.SelectedBrand.ModelLabels, FallbackValue={x:Null}}"
                                    SelectedItem="{x:Bind ViewModel.SelectedBrand.SourceLabel, Mode=TwoWay, FallbackValue={x:Null}}" />
                            </Grid>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ToggleAllButton"
                                Command="{x:Bind ViewModel.ToggleAllVisibleCommand}"
                                Content="{x:Bind ViewModel.ToggleAllLabel}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource Not}}"
                                Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource CollapsedWhenTrue}}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Padding="0,0,0,16">
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Converter={StaticResource Not}}"
                                IsTabStop="False">
                                <StackPanel Spacing="16">
                                    <ItemsRepeater
                                        ItemTemplate="{StaticResource ProfileTile}"
                                        ItemsSource="{x:Bind ViewModel.Profiles}"
                                        Layout="{StaticResource TileLayout}"
                                        Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource CollapsedWhenTrue}}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResults}" Visibility="{x:Bind ViewModel.IsSearching}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="16" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="unlock:CameraProfileGroup">
                                                <StackPanel Spacing="8">
                                                    <TextBlock
                                                        AutomationProperties.HeadingLevel="Level3"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Title, Mode=OneTime}" />
                                                    <ItemsRepeater
                                                        ItemTemplate="{StaticResource ProfileTile}"
                                                        ItemsSource="{x:Bind Items, Mode=OneTime}"
                                                        Layout="{StaticResource TileLayout}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <StackPanel
                                        Margin="0,48"
                                        HorizontalAlignment="Center"
                                        Spacing="12"
                                        Visibility="{x:Bind ViewModel.IsSearchEmpty}">
                                        <FontIcon FontSize="32" Glyph="&#xE721;" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="Try a camera profile name like &quot;Chrome&quot; or a brand like &quot;Canon&quot;."
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <Button
                                            HorizontalAlignment="Center"
                                            AutomationProperties.AutomationId="ClearSearchButton"
                                            Click="ClearSearch_Click"
                                            Content="Clear search" />
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!--  Tray: what is selected plus the one primary action.  -->
            <Grid
                Grid.Row="1"
                Padding="40,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="12"
                Visibility="{x:Bind ViewModel.IsFirstRun, Converter={StaticResource CollapsedWhenTrue}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center">
                    <StackPanel
                        x:Name="ChipsPanel"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.TrayChips, Converter={StaticResource VisibleWhenAny}}">
                        <ItemsRepeater AutomationProperties.Name="Selected camera profiles" ItemsSource="{x:Bind ViewModel.TrayChips}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="unlock:CameraProfileItemViewModel">
                                    <Grid
                                        Padding="12,0,4,0"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        ColumnSpacing="4"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        ToolTipService.ToolTip="{x:Bind Brand.Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="36"
                                            Height="36"
                                            AutomationProperties.AutomationId="ChipRemoveButton"
                                            AutomationProperties.Name="{x:Bind pages:UnlockPage.RemoveChipName(Name)}"
                                            Click="ChipRemove_Click"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Tag="{x:Bind Mode=OneTime}"
                                            ToolTipService.ToolTip="Remove from selection">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.MoreText}"
                            Visibility="{x:Bind ViewModel.MoreText, Converter={StaticResource VisibleWhenText}}" />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind ViewModel.ProgressText}"
                        Visibility="{x:Bind ViewModel.IsBusy}" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ClearButton"
                        AutomationProperties.AutomationId="ClearButton"
                        Command="{x:Bind ViewModel.ClearSelectionCommand}"
                        Content="Clear"
                        Visibility="{x:Bind ViewModel.TrayChips, Converter={StaticResource VisibleWhenAny}}" />
                    <Button
                        AutomationProperties.AutomationId="CancelInstallButton"
                        Command="{x:Bind ViewModel.InstallCancelCommand}"
                        Content="Cancel"
                        Visibility="{x:Bind ViewModel.IsBusy}" />
                    <Button
                        x:Name="InstallButton"
                        MinWidth="168"
                        AutomationProperties.AutomationId="InstallButton"
                        AutomationProperties.Name="{x:Bind ViewModel.InstallLabel}"
                        Command="{x:Bind ViewModel.InstallCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                x:Name="InstallIcon"
                                FontSize="16"
                                Glyph="&#xE896;" />
                            <ProgressRing
                                x:Name="InstallRing"
                                Width="16"
                                Height="16"
                                MinWidth="0"
                                MinHeight="0"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock x:Name="InstallText" Text="{x:Bind ViewModel.InstallLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </SplitView>
</Page>
