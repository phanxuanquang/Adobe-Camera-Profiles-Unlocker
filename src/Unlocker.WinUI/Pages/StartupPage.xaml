<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Unlocker.WinUI.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:DefaultBindMode="OneWay"
    Loaded="Page_Loaded"
    NavigationCacheMode="Disabled">
    <Grid Padding="{StaticResource PagePadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Missing">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger To="CameraRawMissing" Value="{x:Bind ViewModel.State}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LoadingPanel.Visibility" Value="Collapsed" />
                        <Setter Target="MissingPanel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel
            x:Name="LoadingPanel"
            MaxWidth="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <ProgressRing HorizontalAlignment="Center" IsActive="True" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Getting ready" />
        </StackPanel>

        <StackPanel
            x:Name="MissingPanel"
            MaxWidth="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Glyph="&#xE7BA;" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Camera Raw isn't installed" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="This app uses the camera profiles that come with Adobe Camera Raw. Install it, then try again."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button AutomationProperties.AutomationId="GetCameraRawButton"
                    AutomationProperties.Name="Get Camera Raw (opens in browser)"
                    Command="{x:Bind ViewModel.GetCameraRawCommand}"
                    Content="Get Camera Raw"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button AutomationProperties.AutomationId="RetryButton" Command="{x:Bind ViewModel.LoadCommand}" Content="Try again" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
